{
  "name": "MARLI",
  "short_name": "MARLI",
  "description": "Tuner, prepoznavanje akorda i pesmarica za gitaru.",
  "lang": "sr-Latn",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icons/marli-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/marli-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/marli-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/marli-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/tuner.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tuner"
    },
    {
      "src": "screenshots/pesma.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Pesma sa akordima"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://bagaljivko.github.io/Gitara/manifest.webmanifest"
    }
  ],
  "share_target": {
    "action": "./?yt-share=1",
    "method": "GET",
    "params": {
      "title": "st",
      "text": "sx",
      "url": "su"
    }
  }
}
